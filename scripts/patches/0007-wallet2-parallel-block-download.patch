+// Parallel block download while far behind the node. One getblocks.bin request at a time makes a
+// remote node's round trip the limit (about 1 s per 1000-block batch on a public node), so the next few
+// batches are requested at once by explicit start height. A prefetched batch is used only when its first
+// block is the block the wallet has last (the same one-block overlap the normal request returns) and its
+// blocks link up; anything else is dropped and the normal request is made. Near the tip it stays off.
+// BELDEX_WALLET_BLOCK_PREFETCH=<n> sets how many batches are requested ahead (default 3, 0 = off).
+struct wallet2::block_prefetch
+{
+  struct batch
+  {
+    cryptonote::rpc::http_client client;
+    cryptonote::rpc::GET_BLOCKS_BIN::response res;
+    bool ok = false;
+    std::future<void> done;
+  };
+
+  const cryptonote::rpc::http_client &main;
+  const bool no_miner_tx;
+  const size_t depth;
+  std::map<uint64_t, std::unique_ptr<batch>> pending;  // by start height
+
+  static size_t configured_depth()
+  {
+    const char *v = std::getenv("BELDEX_WALLET_BLOCK_PREFETCH");
+    if (!v || !*v)
+      return 3;
+    char *end = nullptr;
+    const unsigned long n = std::strtoul(v, &end, 10);
+    return end && *end == '\0' ? std::min<unsigned long>(n, 8) : 3;
+  }
+
+  block_prefetch(const cryptonote::rpc::http_client &main, bool no_miner_tx)
+    : main{main}, no_miner_tx{no_miner_tx}, depth{configured_depth()} {}
+  block_prefetch(const block_prefetch &) = delete;
+  block_prefetch &operator=(const block_prefetch &) = delete;
+  ~block_prefetch() { clear(); }
+
+  void clear()
+  {
+    for (auto &[h, b] : pending)
+      b->client.cancel();
+    for (auto &[h, b] : pending)
+      if (b->done.valid())
+        b->done.wait();
+    pending.clear();
+  }
+
+  // `next` is where the next normal request will start; `n` is the size of a full batch.
+  void schedule(uint64_t next, size_t n, uint64_t node_height)
+  {
+    while (!pending.empty() && pending.begin()->first < next)
+    {
+      auto it = pending.begin();
+      it->second->client.cancel();
+      if (it->second->done.valid())
+        it->second->done.wait();
+      pending.erase(it);
+    }
+    for (size_t k = 0; k < depth; ++k)
+    {
+      const uint64_t start = next + k * (n - 1);
+      if (start + n >= node_height)
+        break;  // only full batches; the last stretch goes through the normal request
+      if (pending.count(start))
+        continue;
+      auto b = std::make_unique<batch>();
+      b->client.copy_params_from(main);
+      if (std::string proxy = main.get_proxy(); !proxy.empty())
+        b->client.set_proxy(std::move(proxy));  // copy_params_from leaves the proxy out
+      try
+      {
+        b->done = std::async(std::launch::async, [bp = b.get(), start, nmt = no_miner_tx] {
+          try
+          {
+            cryptonote::rpc::GET_BLOCKS_BIN::request req{};
+            req.start_height = start;
+            req.prune = true;
+            req.no_miner_tx = nmt;
+            bp->res = bp->client.binary<cryptonote::rpc::GET_BLOCKS_BIN>(cryptonote::rpc::GET_BLOCKS_BIN::names().front(), req);
+            bp->ok = bp->res.status == cryptonote::rpc::STATUS_OK && bp->res.start_height == start && !bp->res.blocks.empty() &&
+                     bp->res.blocks.size() == bp->res.output_indices.size();
+          }
+          catch (...)
+          {
+            bp->ok = false;
+          }
+        });
+      }
+      catch (const std::exception &)
+      {
+        break;  // no thread for it: the normal request covers it
+      }
+      pending.emplace(start, std::move(b));
+    }
+  }
+
+  bool take(uint64_t start, const crypto::hash &first_hash, uint64_t &blocks_start_height,
+            std::vector<cryptonote::block_complete_entry> &blocks,
+            std::vector<cryptonote::rpc::GET_BLOCKS_BIN::block_output_indices> &o_indices, uint64_t &current_height)
+  {
+    auto it = pending.find(start);
+    if (it == pending.end())
+      return false;
+    batch &b = *it->second;
+    b.done.wait();
+    bool ok = b.ok;
+    if (ok)
+    {
+      cryptonote::block first;
+      crypto::hash h;
+      ok = cryptonote::parse_and_validate_block_from_blob(b.res.blocks.front().block, first, h) && h == first_hash;
+    }
+    if (!ok)
+    {
+      clear();
+      return false;
+    }
+    blocks_start_height = b.res.start_height;
+    blocks = std::move(b.res.blocks);
+    o_indices = std::move(b.res.output_indices);
+    current_height = b.res.current_height;
+    pending.erase(it);
+    return true;
+  }
+};
