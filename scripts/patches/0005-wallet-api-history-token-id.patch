     std::list<std::pair<crypto::hash, tools::wallet2::payment_details>> in_payments;
     auto w = m_wallet->wallet();
+
+    // Privacy tokens. Incoming payments record their token id. Outgoing ones take the token id, token amount
+    // and destinations from wallet2's transfer view, as the CLI's show_transfers does. (The view of an
+    // incoming payment would search every wallet output, so it isn't used for those.) BDX amounts are unchanged.
+    auto apply_in = [](TransactionInfoImpl *ti, const tools::wallet2::payment_details &pd) {
+        ti->m_pay_type = wallet::pay_type_string(pd.m_type);
+        if (pd.m_token_id != crypto::null_tid)
+            ti->m_token_id = tools::type_to_hex(pd.m_token_id);
+    };
+    auto apply_view = [&](TransactionInfoImpl *ti, const wallet::transfer_view &tv) {
+        ti->m_pay_type = wallet::pay_type_string(tv.pay_type);
+        ti->m_token_id = tv.token_id;
+        if (!tv.token_id.empty())
+            ti->m_amount = tv.amount;
+        bool token_dest = false;
+        for (const auto &d : tv.destinations)
+            token_dest = token_dest || !d.token_id.empty();
+        if (token_dest) {
+            ti->m_transfers.clear();
+            for (const auto &d : tv.destinations)
+                ti->m_transfers.push_back({d.amount, d.address, d.token_id});
+        }
+    };
